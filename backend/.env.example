# Copy to backend/.env, use strong unique secrets, and never commit that file.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=https://1wayes.github.io/DESYR-/
PRICE_ALERT_DELIVERY_MODE=preview
CELERY_TASK_ALWAYS_EAGER=1
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1

# Leave these unset for SQLite development. Production requires MySQL.
# MYSQL_DATABASE=desyr
# MYSQL_USER=desyr
# MYSQL_PASSWORD=
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_ROOT_PASSWORD=

# Set PRICE_ALERT_DELIVERY_MODE=smtp only after configuring a real verified sender.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=DESYR <preview@example.invalid>
SESSION_COOKIE_SAMESITE=Lax
TRUST_HTTPS_PROXY=0
